{
  "rules": {
    "chats": {
      // Allow admins to list all chats (for the admin dashboard)
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      
      "$chatId": {
        // Users can read their own chat; Admins can read any chat
        ".read": "auth != null && (auth.uid === $chatId || root.child('admins').child(auth.uid).exists())",
        
        // Users can write to their own chat; Admins can write to any chat
        ".write": "auth != null && (auth.uid === $chatId || root.child('admins').child(auth.uid).exists())",
        
        "messages": {
          "$messageId": {
            // Ensure data integrity: messages must have text and sender
            ".validate": "newData.hasChildren(['text', 'sender', 'createdAt'])"
          }
        },
        "metadata": {
          // Metadata can be read/written by the user or admin
          ".read": "auth != null && (auth.uid === $chatId || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && (auth.uid === $chatId || root.child('admins').child(auth.uid).exists())"
        },
        "typing": {
          // Typing status
          ".read": "auth != null && (auth.uid === $chatId || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && (auth.uid === $chatId || root.child('admins').child(auth.uid).exists())"
        }
      }
    },
    "admins": {
      // Only admins can see the list of admins
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      // Admins can grant/revoke admin status for others
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }

  }
}

